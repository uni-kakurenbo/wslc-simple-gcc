# Only source, metadata and explicit test/example directories belong in this repository.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/crates/
!/examples/

/crates/*
!/crates/wslc-runtime/
!/crates/wslc-simple-gcc/
/crates/*/*
!/crates/*/Cargo.toml
!/crates/*/src/
!/crates/*/tests/
!/crates/wslc-simple-gcc/assets/
/crates/*/src/*
!/crates/*/src/*.rs
/crates/*/tests/*
!/crates/*/tests/*.rs
/crates/wslc-simple-gcc/assets/*
!/crates/wslc-simple-gcc/assets/*.sh

/examples/*
!/examples/hello.c
!/examples/hello.cpp
